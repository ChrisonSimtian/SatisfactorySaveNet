<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 is required by Fallout.Common 10.x; the fork's shipped libraries
         still target net8.0 — that's set per-project. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1812;CA1822;CA2007;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" />
  </ItemGroup>

</Project>
