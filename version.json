{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "4.1",
  "publicReleaseRefSpec": [
    "^refs/heads/main$",
    "^refs/tags/v\\d+\\.\\d+"
  ],
  "pathFilters": [
    ".",
    ":!:.github/",
    ":!:build/",
    ":!:.nuke/",
    ":!:SatisfactorySaveNet.Tests/",
    ":!:SatisfactorySaveNet.Benchmarks/",
    ":!:README.md",
    ":!:TODO.md",
    ":!:LICENSE",
    ":!:.gitignore",
    ":!:.editorconfig"
  ],
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  }
}
